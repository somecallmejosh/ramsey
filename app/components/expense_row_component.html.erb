<li id="<%= dom_id(@expense) %>" class="flex items-center gap-3 px-3 py-2.5 rounded-[20px] hover:bg-porcelain-2 transition-colors duration-200">
  <span class="grid place-items-center w-10 h-10 rounded-full shrink-0 bg-porcelain-2 text-[15px] font-bold text-graphite" aria-hidden="true">
    <%= @expense.user.display_name.first %>
  </span>
  <div class="flex-1 min-w-0">
    <p class="text-[15px] font-bold text-ink truncate"><%= @expense.note.presence || @expense.user.display_name %></p>
    <p class="text-[13px] text-mute truncate">
      <%= @expense.note.present? ? "#{@expense.user.display_name} · " : "" %><%= helpers.friendly_day(@expense.transacted_on) %>
    </p>
  </div>
  <p class="text-[15px] font-bold tabular-nums text-ink">−<%= amount %></p>

  <% if can_delete? %>
    <%= button_to envelope_expense_path(envelope, @expense),
          method: :delete,
          class: "press -mr-1 grid place-items-center w-11 h-11 rounded-full text-mute hover:text-claret hover:bg-claret-soft",
          aria: { label: "Remove #{amount} purchase, #{helpers.friendly_day(@expense.transacted_on)}" },
          form: { data: { turbo_confirm: "Remove #{amount} from #{envelope.name}?" } } do %>
      <%= icon "trash", classes: "w-5 h-5" %>
    <% end %>
  <% end %>
</li>
