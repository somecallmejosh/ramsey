<div>
  <h2 class="<%= ui.page_heading %> mb-1">Log Expense</h2>
  <p class="<%= ui.label(:secondary) %> mb-6"><%= @envelope.name %></p>

  <%= form_with model: [@envelope, @expense] do |f| %>

    <% if @expense.errors.any? %>
      <div class="<%= ui.warning_banner %> mb-4" role="alert">
        <% @expense.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="mb-4">
      <label for="expense_amount" class="<%= ui.label %> block mb-1">
        Amount <span aria-hidden="true">*</span>
      </label>
      <%= f.number_field :amount,
            id: "expense_amount",
            placeholder: "0.00",
            step: "0.01",
            min: "0.01",
            class: ui.input(@expense.errors[:amount].any? ? :error : :default),
            aria: {
              required: true,
              describedby: @expense.errors[:amount].any? ? "expense_amount_error" : nil,
              invalid: @expense.errors[:amount].any?
            },
            onkeydown: "if(event.key==='Enter'){event.preventDefault();this.form.requestSubmit()}",
            autofocus: true %>
      <% if @expense.errors[:amount].any? %>
        <p id="expense_amount_error" class="text-hs-red text-[13px] mt-1">
          <%= @expense.errors[:amount].first %>
        </p>
      <% end %>
    </div>

    <div class="mb-4">
      <label for="expense_note" class="<%= ui.label %> block mb-1">Note (optional)</label>
      <%= f.text_field :note,
            id: "expense_note",
            placeholder: "What was this for?",
            class: ui.input %>
    </div>

    <div class="mb-6">
      <label for="expense_transacted_on" class="<%= ui.label %> block mb-1">
        Date <span aria-hidden="true">*</span>
      </label>
      <%= f.date_field :transacted_on,
            id: "expense_transacted_on",
            max: Date.current.to_s,
            class: ui.input,
            aria: { required: true } %>
    </div>

    <div class="fixed bottom-20 left-0 right-0 px-4 max-w-md mx-auto">
      <%= f.submit "Confirm",
            class: "#{ui.button(:primary)} w-full",
            data: { disable_with: "Saving…" } %>
    </div>

  <% end %>
</div>
