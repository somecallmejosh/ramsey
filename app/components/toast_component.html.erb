<div class="pointer-events-auto mx-auto w-full max-w-md flex items-center gap-3 rounded-[24px] bg-ink text-porcelain pl-4 pr-2 py-2.5 shadow-[var(--shadow-2)] animate-toast-in"
     data-controller="flash"
     data-flash-timeout-value="<%= timeout %>">
  <%= icon icon_name, classes: "w-6 h-6 shrink-0 #{@tone == :success ? "text-sage-bright" : "text-porcelain"}" %>
  <div class="flex-1 min-w-0">
    <p class="text-[15px] font-medium leading-snug"><%= @message %></p>
    <% if @detail %>
      <p class="text-[13px] leading-snug text-porcelain/70 tabular-nums"><%= @detail %></p>
    <% end %>
  </div>
  <% if @undo_path %>
    <%= button_to "Undo", @undo_path,
          method: @undo_method,
          params: @undo_params,
          class: "shrink-0 min-h-[44px] px-4 rounded-[10px] text-[15px] font-semibold text-porcelain underline-offset-4 hover:bg-porcelain/10 active:bg-porcelain/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-porcelain",
          form: { data: { turbo_submits_with: "Undoing…" } } %>
  <% else %>
    <button type="button"
            class="shrink-0 grid place-items-center w-11 h-11 rounded-full text-porcelain/70 hover:bg-porcelain/10"
            aria-label="Dismiss"
            data-action="flash#remove">
      <%= icon "close", classes: "w-5 h-5" %>
    </button>
  <% end %>
</div>
