<nav class="<%= ui.nav_bar %>" aria-label="Main navigation">
  <div class="flex items-center justify-around max-w-md mx-auto">
    <%= link_to root_path, class: ui.nav_item(active: active?(root_path)), aria: { label: "Dashboard" } do %>
      <%= icon "budget", classes: "w-6 h-6 text-blue-500" %>
      <span>Budget</span>
    <% end %>

    <%= link_to new_meal_plan_path, class: ui.nav_item(active: active?(new_meal_plan_path)), aria: { label: "Meal Planner" } do %>
      <%= icon "meal", classes: "w-6 h-6" %>
      <span>Meals</span>
    <% end %>

    <%= link_to lunch_logs_path, class: ui.nav_item(active: active?(lunch_logs_path)), aria: { label: "Lunch Tracker" } do %>
      <%= icon "lunch", classes: "w-6 h-6" %>
      <span>Lunch</span>
    <% end %>

    <% if admin? %>
      <%= link_to admin_settings_path, class: ui.nav_item(active: active?("/admin")), aria: { label: "Settings" } do %>
        <%= icon "settings", classes: "w-6 h-6" %>
        <span>Settings</span>
      <% end %>
    <% end %>

    <%= button_to session_path, method: :delete,
          class: ui.nav_item,
          aria: { label: "Sign out" },
          form: { "data-turbo-confirm": "Sign out?" } do %>
      <%= icon "lock", classes: "w-6 h-6" %>
      <span>Sign out</span>
    <% end %>

  </div>
</nav>
