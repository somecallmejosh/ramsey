<li id="<%= dom_id_for_row %>" class="flex items-center gap-1 pr-1">
  <%# The row itself opens the category's page (purchases and spending). %>
  <%= link_to history_path,
        class: "flex-1 min-w-0 flex items-center gap-2.5 pl-2 pr-1.5 py-3 rounded-[20px] transition-colors duration-200 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-porcelain-2 active:bg-porcelain-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent",
        aria: { label: history_label } do %>
    <%= render RingComponent.new(percent: bar_percent, size: 46, stroke: 3.5, color: ring_class) do %>
      <span class="grid place-items-center w-9 h-9 rounded-full <%= look.tile %> <%= look.ink %>" aria-hidden="true">
        <%= icon look.icon, classes: "w-5 h-5" %>
      </span>
    <% end %>
    <span class="flex-1 min-w-0">
      <span class="block font-bold text-[15px] leading-snug text-ink truncate"><%= @envelope.name %></span>
      <span class="block text-[12px] text-mute tabular-nums truncate"><%= subline %></span>
    </span>
    <span class="text-right shrink-0">
      <span class="block font-bold text-[15px] leading-snug tabular-nums whitespace-nowrap <%= headline_class %>"><%= headline_amount %></span>
      <span class="block text-[12px] text-mute whitespace-nowrap"><%= headline_word %></span>
    </span>
  <% end %>

  <% if loggable? %>
    <%# Separate, obvious button for logging a purchase. %>
    <button type="button"
            class="press shrink-0 grid place-items-center w-11 h-11 -ml-0.5 rounded-full bg-ink text-surface shadow-[0_6px_14px_-6px_oklch(0.2_0.02_265/0.6)] hover:bg-ink-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
            aria-label="<%= accessible_label %>"
            title="Log a purchase in <%= @envelope.name %>"
            data-action="logger#open"
            <%= tag.attributes(data: logger_params) %>>
      <%= icon "plus", classes: "w-5 h-5" %>
    </button>
  <% end %>
</li>
