<% user_errors = ->(attr) { @user ? @user.errors.full_messages_for(attr) : [] } %>
<div class="flex items-center justify-center">
  <div class="w-full max-w-sm">

    <div class="mt-8 mb-4">
      <%= image_tag "logos/logo.svg", class: "h-16 w-auto", alt: "Clempo" %>
      <h1 class="<%= ui.section_heading(extra: "mt-4") %>">Join <%= @invitation.account.name %></h1>
      <p class="<%= ui.label(:secondary) %> mt-1">You've been invited to share a budget on Clempo. Pick the email and password you'll sign in with.</p>
    </div>

    <div class="<%= ui.card %>">
      <%= form_with url: accept_invitation_path(token: @invitation.token), data: { turbo: false, controller: "submit-feedback", action: "submit->submit-feedback#busy" } do |f| %>

        <%= render FormErrorsComponent.new(record: @user) %>

        <%= render "shared/text_field",
              f: f, type: :email_field, field: :email_address, label: "Email address",
              errors: user_errors.(:email_address),
              required: true,
              autofocus: true,
              autocomplete: "email",
              placeholder: "you@example.com",
              value: params[:email_address] %>

        <%= render "shared/password_field",
              f: f, field: :password, label: "Password",
              autocomplete: "new-password",
              hint: "At least 8 characters",
              errors: user_errors.(:password) %>

        <%= render "shared/password_field",
              f: f, field: :password_confirmation, label: "Confirm password",
              autocomplete: "new-password",
              errors: user_errors.(:password_confirmation),
              wrapper_class: "mb-6" %>

        <%= f.submit "Join account", class: "#{ui.button(:primary)} w-full", data: { turbo_submits_with: "Creating account…" } %>

      <% end %>

      <div class="mt-4">
        <%= link_to "Already have an account? Sign in", new_session_path, class: ui.link(:subtle) %>
      </div>
    </div>

  </div>
</div>
