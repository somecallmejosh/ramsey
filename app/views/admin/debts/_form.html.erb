<%= form_with model: [:admin, debt], class: "space-y-5" do |f| %>
  <% if debt.errors.any? %>
    <div class="<%= ui.warning_banner %>">
      <%= icon "info", classes: "w-5 h-5 flex-none text-hs-red" %>
      <span><%= debt.errors.full_messages.first %></span>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: ui.label %>
    <%= f.text_field :name, class: "#{ui.input} mt-1", placeholder: "e.g. Chase Personal Loan", required: true %>
  </div>

  <div>
    <%= f.label :debt_type, "Type", class: ui.label %>
    <%= f.select :debt_type,
          Debt.debt_types.keys.map { |k| [k.humanize.titleize, k] },
          { prompt: "Select type" },
          class: "#{ui.input} mt-1", required: true %>
  </div>

  <div>
    <%= f.label :original_balance, "Original balance", class: ui.label %>
    <%= f.number_field :original_balance, step: "0.01", min: "0",
          class: "#{ui.input} mt-1", placeholder: "0.00", required: true %>
  </div>

  <div>
    <%= f.label :current_balance, "Current balance", class: ui.label %>
    <%= f.number_field :current_balance, step: "0.01", min: "0",
          class: "#{ui.input} mt-1", placeholder: "0.00", required: true %>
  </div>

  <div>
    <%= f.label :minimum_payment, "Minimum monthly payment", class: ui.label %>
    <%= f.number_field :minimum_payment, step: "0.01", min: "0",
          class: "#{ui.input} mt-1", placeholder: "0.00", required: true %>
  </div>

  <div>
    <%= f.label :interest_rate, "Interest rate % (optional)", class: ui.label %>
    <%= f.number_field :interest_rate, step: "0.001", min: "0",
          class: "#{ui.input} mt-1", placeholder: "e.g. 6.25" %>
  </div>

  <div>
    <%= f.label :position, "Snowball order", class: ui.label %>
    <%= f.number_field :position, min: "1", class: "#{ui.input} mt-1", required: true %>
    <p class="text-[12px] text-hs-muted mt-1">1 = current target. Lower numbers appear first.</p>
  </div>

  <%= f.submit class: "#{ui.button(:primary)} w-full mt-2" %>
<% end %>
