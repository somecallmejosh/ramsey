<% content_for :title, "Settings · Clempo" %>
<% month_name = Date.current.strftime("%B") %>
<div class="max-w-lg mx-auto">
  <h1 class="<%= ui.page_heading %> mb-6">Settings</h1>

  <section aria-labelledby="your-account-heading" class="mb-10">
    <h2 id="your-account-heading" class="text-[20px] font-semibold text-ink mb-3">Your account</h2>
    <div class="panel px-5 py-4 flex items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="text-[15px] font-medium text-ink">Password</p>
        <p class="text-[13px] text-mute truncate"><%= current_user.email_address %></p>
      </div>
      <%= link_to "Change password", edit_account_password_path, class: ui.button(:secondary, extra: "px-4 py-2.5 shrink-0 whitespace-nowrap") %>
    </div>
  </section>

  <% notifications_on = current_user.notifications_enabled? %>
  <section aria-labelledby="notifications-heading" class="mb-10"
           data-controller="notification-setting"
           data-notification-setting-enabled-value="<%= notifications_on %>">
    <h2 id="notifications-heading" class="text-[20px] font-semibold text-ink mb-3">Notifications</h2>
    <div class="panel px-5 py-4">
      <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="text-[15px] font-medium text-ink">
            Household alerts
            <span class="<%= ui.badge(notifications_on ? :success : :neutral) %> ml-1"><%= notifications_on ? "On" : "Off" %></span>
          </p>
          <p class="text-[13px] text-mute">When someone logs a purchase or packs lunch, and when a category is nearly spent.</p>
        </div>
        <%= button_to (notifications_on ? "Turn off" : "Turn on"), notification_preference_path,
              method: :patch,
              params: { notifications_enabled: !notifications_on },
              class: ui.button(notifications_on ? :secondary : :primary, extra: "px-4 py-2.5 shrink-0 whitespace-nowrap"),
              data: (notifications_on ? {} : { action: "notification-setting#turnOn" }) %>
      </div>
      <button type="button" hidden
              data-notification-setting-target="setup"
              data-action="notification-setting#setUp"
              class="<%= ui.button(:secondary, extra: "w-full mt-4") %>">
        Set up this device
      </button>
      <p hidden data-notification-setting-target="device" class="text-[13px] text-graphite mt-3"></p>
    </div>
  </section>

  <% if current_user.owner? %>
  <section aria-labelledby="members-heading" class="mb-10">
    <div class="flex items-center justify-between gap-3 mb-3">
      <h2 id="members-heading" class="text-[20px] font-semibold text-ink">People</h2>
      <%= link_to "Invite someone", invitations_path, class: ui.button(:secondary, extra: "px-4 py-2.5") %>
    </div>
    <ul class="panel px-5" role="list">
      <% @users.each do |user| %>
        <li class="flex items-center justify-between gap-3 py-3 border-b border-line last:border-0">
          <div class="min-w-0">
            <p class="text-[15px] font-medium text-ink"><%= user.display_name %><%= " (you)" if user == current_user %></p>
            <p class="text-[13px] text-mute truncate"><%= user.email_address %></p>
          </div>
          <span class="<%= ui.badge(user.owner? ? :accent : :neutral) %>"><%= user.owner? ? "Owner" : "Member" %></span>
        </li>
      <% end %>
    </ul>
  </section>

  <section aria-labelledby="categories-heading" class="mb-10">
    <div class="flex items-center justify-between gap-3 mb-1">
      <h2 id="categories-heading" class="text-[20px] font-semibold text-ink">Monthly budgets</h2>
      <%= link_to "Add category", new_envelope_path, class: ui.button(:secondary, extra: "px-4 py-2.5") %>
    </div>
    <p class="text-[13px] text-mute mb-3">
      Amounts for <%= month_name %>. Each new month starts with the same amounts.
    </p>

    <% if @envelopes.empty? %>
      <div class="panel px-5 py-8 text-center">
        <p class="text-[15px] text-graphite mb-3">No categories yet. Add one for each thing you budget for, like Groceries or Gas.</p>
        <%= link_to "Add your first category", new_envelope_path, class: ui.button(:primary) %>
      </div>
    <% else %>
      <% active, hidden = @envelopes.partition(&:active?) %>
      <%= form_with url: admin_settings_path, method: :patch do |f| %>
        <ul class="panel px-5 mb-4" role="list">
          <% active.each do |envelope| %>
            <li class="flex items-center gap-3 py-3 border-b border-line last:border-0">
              <div class="flex-1 min-w-0">
                <label for="budget_envelope_<%= envelope.id %>" class="block text-[15px] font-medium text-ink truncate"><%= envelope.name %></label>
                <div class="flex gap-3 text-[13px]">
                  <%= link_to "Edit", edit_envelope_path(envelope), class: "text-accent hover:underline py-1",
                        aria: { label: "Edit #{envelope.name}" } %>
                  <%= link_to "Hide", deactivate_admin_envelope_path(envelope),
                        data: { turbo_method: :patch, turbo_confirm: "Hide #{envelope.name}? It disappears from Budget, but its past purchases are kept. You can show it again here." },
                        class: "text-graphite hover:text-claret py-1",
                        aria: { label: "Hide #{envelope.name}" } %>
                </div>
              </div>
              <div class="relative w-32 shrink-0">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-mute" aria-hidden="true">$</span>
                <input type="number" inputmode="decimal"
                       name="budgets[<%= envelope.id %>]"
                       id="budget_envelope_<%= envelope.id %>"
                       value="<%= format("%.2f", @budgets[envelope.id]&.amount || 0) %>"
                       step="0.01" min="0"
                       class="<%= ui.input %> !pl-7 !pr-3 text-right tabular-nums">
              </div>
            </li>
          <% end %>
        </ul>
        <%= f.submit "Save budgets", class: ui.button(:primary, extra: "w-full"), data: { turbo_submits_with: "Saving…" } %>
      <% end %>

      <% if hidden.any? %>
        <h3 class="text-[15px] font-semibold text-graphite mt-6 mb-2">Hidden categories</h3>
        <ul class="panel px-5" role="list">
          <% hidden.each do |envelope| %>
            <li class="flex items-center justify-between gap-3 py-3 border-b border-line last:border-0">
              <span class="text-[15px] text-graphite truncate"><%= envelope.name %></span>
              <%= link_to "Show again", reactivate_admin_envelope_path(envelope),
                    data: { turbo_method: :patch },
                    class: "text-[15px] text-accent hover:underline min-h-[44px] inline-flex items-center",
                    aria: { label: "Show #{envelope.name} again" } %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </section>

  <section aria-labelledby="household-heading" class="mb-6">
    <h2 id="household-heading" class="text-[20px] font-semibold text-ink mb-3">Household</h2>
    <div class="panel px-5 py-4 space-y-5">
      <div>
        <p class="text-[15px] font-medium text-ink">Download your data</p>
        <p class="text-[13px] text-mute mb-3">Everything in <%= current_account.name %> as a spreadsheet (CSV) file.</p>
        <%= link_to "Download", export_admin_account_path, class: ui.button(:secondary), data: { turbo: false } %>
      </div>

      <hr class="border-line">

      <details class="group">
        <summary class="cursor-pointer list-none text-[15px] font-medium text-claret min-h-[44px] flex items-center justify-between">
          Delete household
          <%= icon "caret-down", classes: "w-5 h-5 transition-transform group-open:rotate-180" %>
        </summary>
        <div class="pt-2">
          <p class="text-[15px] text-graphite mb-3">
            This permanently deletes <strong class="text-ink"><%= current_account.name %></strong>: everyone's sign-in,
            every category, purchase, debt and meal plan. It can't be undone. Download your data first if you might want it.
          </p>
          <%= form_with url: admin_account_path, method: :delete, class: "space-y-3" do |f| %>
            <div>
              <label for="confirm_name" class="<%= ui.label %> block mb-1">Type <strong class="text-ink"><%= current_account.name %></strong> to confirm</label>
              <%= text_field_tag :confirm_name, nil, id: "confirm_name", autocomplete: "off", required: true, class: ui.input %>
            </div>
            <%= f.submit "Delete #{current_account.name} forever", class: ui.button(:error, extra: "w-full"),
                  data: { turbo_submits_with: "Deleting…" } %>
          <% end %>
        </div>
      </details>
    </div>
  </section>
  <% end %>
</div>
