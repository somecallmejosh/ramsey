<h1 class="<%= ui.page_heading %> mb-6">Settings</h1>

<div class="flex items-center justify-between mb-4">
  <h2 class="<%= ui.section_heading %> mb-0">Envelopes</h2>
  <%= link_to "Add envelope", new_envelope_path, class: "#{ui.button(:secondary, extra: "text-sm px-5 py-2")}" %>
</div>

<div class="<%= ui.card %>">
  <% if @envelopes.empty? %>
    <p class="<%= ui.label(:secondary) %> text-center py-8">No envelopes yet.</p>
  <% else %>
    <% @envelopes.each do |envelope| %>
      <div class="flex items-center justify-between py-4 border-b border-hs-border last:border-0">
        <div>
          <p class="text-lg font-semibold text-hs-navy <%= "opacity-40" unless envelope.active? %>">
            <%= envelope.name %>
            <% unless envelope.active? %>
              <span class="ml-2 text-[13px] font-normal text-hs-muted">(inactive)</span>
            <% end %>
          </p>
          <% if (budget = @budgets[envelope.id]) %>
            <p class="<%= ui.label(:secondary) %>">
              <%= number_to_currency(budget.amount) %> / month
              — <%= link_to "Edit", edit_envelope_budget_path(budget), class: ui.link(:subtle) %>
            </p>
          <% else %>
            <p class="<%= ui.label(:secondary) %>">No budget set for this month</p>
          <% end %>
        </div>
        <%= link_to "Edit envelope", edit_envelope_path(envelope), class: ui.link(:subtle) %>
      </div>
    <% end %>
  <% end %>
</div>

<%= render NavComponent.new(current_user: current_user, current_path: request.path) %>
