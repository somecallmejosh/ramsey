<h1 class="<%= ui.page_heading %> mb-6">Settings</h1>

<div class="flex items-center justify-between mb-4">
  <h2 class="<%= ui.section_heading %> mb-0">Envelopes</h2>
  <%= link_to "Add envelope", new_envelope_path, class: "#{ui.button(:secondary, extra: "text-sm px-5 py-2")}" %>
</div>

<% if @envelopes.empty? %>
  <div class="<%= ui.card %> text-center py-8">
    <p class="<%= ui.label(:secondary) %>">No envelopes yet.</p>
  </div>
<% else %>
  <%# Bulk budget update form — one submit covers all inline inputs %>
  <%= form_with url: admin_settings_path, method: :patch, data: { turbo: false } do |f| %>
    <div class="<%= ui.card %> mb-4">
      <% @envelopes.each_with_index do |envelope, i| %>
        <div class="py-4 border-b border-hs-border last:border-0">
          <div class="flex items-center justify-between gap-4">
            <%# Name + status %>
            <div class="flex-1 min-w-0">
              <p class="text-lg font-semibold text-hs-navy <%= "opacity-40" unless envelope.active? %> truncate">
                <%= envelope.name %>
                <% unless envelope.active? %>
                  <span class="ml-2 text-[13px] font-normal text-hs-muted">(inactive)</span>
                <% end %>
              </p>
            </div>

            <%# Inline budget amount input %>
            <% if envelope.active? %>
              <% budget = @budgets[envelope.id] %>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-hs-muted text-lg">$</span>
                <input type="number"
                       name="budgets[<%= envelope.id %>]"
                       id="budget_envelope_<%= envelope.id %>"
                       value="<%= budget&.amount || 0 %>"
                       step="0.01"
                       min="0"
                       placeholder="0.00"
                       class="w-28 rounded-[10px] border border-hs-border px-3 py-2 text-lg text-hs-navy placeholder:text-hs-muted focus:outline-none focus-visible:ring-2 focus-visible:border-hs-primary focus-visible:ring-hs-primary text-right"
                       aria-label="Budget for <%= envelope.name %>" />
              </div>
            <% end %>

            <%# Deactivate / reactivate toggle %>
            <div class="shrink-0">
              <% if envelope.active? %>
                <%= button_to deactivate_admin_envelope_path(envelope),
                      method: :patch,
                      class: "text-[13px] text-hs-muted hover:text-hs-red transition-colors font-semibold",
                      form: { "data-turbo-confirm": "Deactivate #{envelope.name}? It will hide from the dashboard." } do %>
                  Deactivate
                <% end %>
              <% else %>
                <%= button_to reactivate_admin_envelope_path(envelope),
                      method: :patch,
                      class: "text-[13px] text-hs-primary hover:underline font-semibold" do %>
                  Reactivate
                <% end %>
              <% end %>
            </div>
          </div>

          <%# Per-envelope link to rename/edit %>
          <div class="mt-2">
            <%= link_to "Edit name & position", edit_envelope_path(envelope), class: ui.link(:subtle) %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Submit budgets %>
    <div class="mb-6">
      <%= f.submit "Save budgets",
            class: "#{ui.button(:primary, extra: "text-sm px-8 py-3")} w-full",
            data: { disable_with: "Saving…" } %>
    </div>
  <% end %>
<% end %>
