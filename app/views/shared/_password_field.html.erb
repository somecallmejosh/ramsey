<%# locals: (f:, field:, label:, autocomplete:, errors: [], hint: nil, autofocus: false, wrapper_class: "mb-4") %>
<%# Password input with a Show/Hide toggle, optional hint and inline error. %>
<% id = field.to_s %>
<% describedby = [ ("#{id}_hint" if hint), ("#{id}_error" if errors.any?) ].compact.join(" ").presence %>
<div class="<%= wrapper_class %>">
  <label for="<%= id %>" class="<%= ui.label %> block mb-1"><%= label %></label>
  <div class="relative" data-controller="password-visibility">
    <%= f.password_field field,
          id: id,
          required: true,
          autofocus: autofocus,
          autocomplete: autocomplete,
          maxlength: 72,
          class: "#{ui.input(errors.any? ? :error : :default)} pr-20",
          aria: { describedby: describedby, invalid: (errors.any? ? "true" : nil) },
          data: { password_visibility_target: "input" } %>
    <button type="button"
            hidden
            aria-pressed="false"
            aria-controls="<%= id %>"
            class="absolute right-1 top-1/2 -translate-y-1/2 min-h-[44px] min-w-[44px] px-3 rounded-[8px] <%= ui.type(:label) %> hover:text-ink hover:bg-porcelain-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            data-password-visibility-target="button"
            data-action="password-visibility#toggle">
      <span data-password-visibility-target="text">Show</span><span class="sr-only"> password</span>
    </button>
  </div>
  <% if hint %>
    <p id="<%= id %>_hint" class="<%= ui.type(:small, extra: "mt-1") %>"><%= hint %></p>
  <% end %>
  <% if errors.any? %>
    <p id="<%= id %>_error" class="<%= ui.field_error %>"><%= errors.first %></p>
  <% end %>
</div>
