<% if authenticated? && !current_user.push_subscriptions.exists? %>
  <div data-controller="push-notifications"
       class="fixed inset-0 z-50 flex items-end justify-center p-4 pointer-events-none">
    <div class="bg-porcelain-2 border border-line rounded-[20px] shadow-[var(--shadow-2)] p-6 max-w-sm w-full pointer-events-auto">
      <h2 class="<%= ui.section_heading %> mb-2">Stay in the loop</h2>
      <p class="<%= ui.label(:secondary) %> mb-6">
        Get notified when Josh or Sally logs a transaction or packs lunch.
      </p>
      <div class="flex gap-3">
        <button data-action="push-notifications#enable"
                class="<%= ui.button(:primary, extra: "flex-1") %>">
          Enable notifications
        </button>
        <button data-action="push-notifications#dismiss"
                class="<%= ui.button(:secondary, extra: "flex-1") %>">
          Not now
        </button>
      </div>
    </div>
  </div>
<% end %>
