<%# The "log a purchase" sheet. Rendered once on the dashboard so it opens
    instantly; logger_controller.js points it at the envelope that was tapped. %>
<dialog data-logger-target="dialog"
        aria-labelledby="logger-title"
        tabindex="-1"
        class="logger-sheet bg-surface text-ink focus:outline-none">
  <%= form_with url: "", scope: :expense, method: :post,
        class: "flex flex-col h-full",
        data: {
          logger_target: "form",
          action: "turbo:submit-start->logger#submitting turbo:submit-end->logger#submitted"
        } do |f| %>
    <%= f.hidden_field :amount, data: { logger_target: "amountField" }, id: "logger_amount" %>
    <%= f.hidden_field :transacted_on, value: Date.current.iso8601, data: { logger_target: "dateField" }, id: "logger_transacted_on" %>

    <div class="mx-auto mt-2.5 h-1.5 w-10 rounded-full bg-porcelain-3" aria-hidden="true"></div>
    <header class="flex items-center justify-between gap-2 px-3 pt-2">
      <button type="button"
              class="press min-h-[44px] px-4 rounded-full text-[15px] font-semibold text-graphite bg-porcelain-2 hover:bg-porcelain-3"
              data-action="logger#close">
        Cancel
      </button>
      <h2 id="logger-title" class="flex-1 text-center text-[17px] font-bold truncate" data-logger-target="title">Log a purchase</h2>
      <a href="#" class="press min-h-[44px] px-4 inline-flex items-center rounded-full text-[15px] font-semibold text-accent bg-accent-soft hover:brightness-95"
         data-logger-target="historyLink" data-turbo-frame="_top">
        History
      </a>
    </header>

    <div class="px-5 pt-4 pb-2 text-center">
      <p class="sr-only" id="logger-amount-label">Amount</p>
      <output class="block text-[60px] leading-none font-extrabold tracking-[-0.04em] tabular-nums text-mute"
              aria-labelledby="logger-amount-label"
              aria-live="polite"
              data-logger-target="display">$0</output>
      <p class="mt-3 min-h-[22px] text-[15px] tabular-nums text-graphite" data-logger-target="balance"></p>
    </div>

    <div id="logger-error" data-logger-target="error" role="alert" class="px-5"></div>

    <fieldset class="px-5 pt-2">
      <legend class="sr-only">When was this?</legend>
      <div class="grid grid-cols-3 gap-1 p-1 rounded-full bg-porcelain-2">
        <% [ [ "today", "Today" ], [ "yesterday", "Yesterday" ], [ "earlier", "Earlier" ] ].each_with_index do |(value, label), i| %>
          <label class="relative">
            <input type="radio" name="logger_when" value="<%= value %>" class="peer sr-only"
                   <%= "checked" if i.zero? %>
                   data-action="logger#chooseDay">
            <span class="block text-center min-h-[42px] leading-[42px] rounded-full text-[15px] font-semibold text-graphite cursor-pointer transition-colors duration-200 ease-[cubic-bezier(0.32,0.72,0,1)] peer-checked:bg-ink peer-checked:text-surface peer-focus-visible:ring-2 peer-focus-visible:ring-accent peer-focus-visible:ring-offset-2">
              <%= label %>
            </span>
          </label>
        <% end %>
      </div>
      <div class="mt-2" hidden data-logger-target="datePicker">
        <label for="logger_date" class="sr-only">Date</label>
        <input type="date" id="logger_date" max="<%= Date.current.iso8601 %>"
               class="<%= ui.input %>"
               data-logger-target="dateInput"
               data-action="change->logger#pickDate">
      </div>
    </fieldset>

    <div class="px-5 pt-2">
      <label for="logger_note" class="sr-only">Note (optional)</label>
      <%= f.text_field :note, id: "logger_note",
            placeholder: "Add a note (optional)",
            maxlength: 120,
            autocomplete: "off",
            data: { lpignore: "true", "1p-ignore": "", logger_target: "note" },
            enterkeyhint: "done",
            class: "w-full min-h-[48px] rounded-full bg-porcelain-2 border border-transparent px-5 text-[16px] text-ink placeholder:text-mute focus:outline-none focus:bg-surface focus:border-accent" %>
    </div>

    <div class="grid grid-cols-3 gap-2 px-5 pt-4" data-logger-target="keypad">
      <% %w[1 2 3 4 5 6 7 8 9 . 0].each do |key| %>
        <button type="button"
                class="logger-key"
                data-action="logger#press"
                data-logger-key-param="<%= key %>"
                aria-label="<%= key == "." ? "Decimal point" : key %>">
          <%= key %>
        </button>
      <% end %>
      <button type="button" class="logger-key" data-action="logger#backspace" aria-label="Delete last digit">
        <%= icon "backspace", classes: "w-7 h-7" %>
      </button>
    </div>

    <div class="px-5 pt-4 pb-[max(1.25rem,env(safe-area-inset-bottom))]">
      <button type="submit"
              disabled
              class="<%= ui.button(:primary, extra: "group w-full min-h-[60px] text-[17px] font-bold !justify-between pl-7 pr-2") %>"
              data-logger-target="submit">
        <span data-logger-target="submitLabel">Enter an amount</span>
        <span class="grid place-items-center w-11 h-11 rounded-full bg-surface/15 transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] group-enabled:group-hover:translate-x-0.5 group-enabled:group-hover:-translate-y-px" aria-hidden="true">
          <%= icon "arrow-right", classes: "w-5 h-5" %>
        </span>
      </button>
    </div>
  <% end %>
</dialog>
