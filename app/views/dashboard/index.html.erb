<%= render PageHeadingComponent.new(current_user: current_user, selected_date: @selected_date) %>

<%# Month selector %>
<div class="flex gap-2 overflow-x-auto pb-2 mb-6 -mx-4 px-4 scrollbar-hide" role="navigation" aria-label="Month navigation">
  <% 0.upto(6) do |n| %>
    <% d = Date.current.beginning_of_month - n.months %>
    <% is_current = d.month == @month && d.year == @year %>
    <%= link_to "#{d.strftime("%b")} #{d.year != Date.current.year ? d.year : ""}".strip,
          dashboard_path(year: d.year, month: d.month),
          class: "flex-none px-4 py-2 rounded-full text-[13px] font-semibold whitespace-nowrap transition-colors #{is_current ? "bg-hs-primary text-white" : "bg-white text-hs-slate border border-hs-border hover:border-hs-primary"}" %>
  <% end %>
</div>

<%# Envelope cards %>
<div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
  <% @envelopes.each do |envelope| %>
    <%= render EnvelopeCardComponent.new(
          envelope:     envelope,
          budget:       @budgets[envelope.id] || 0,
          spent:        @totals[envelope.id]  || 0,
          current_user: current_user,
          year:         @year,
          month:        @month) %>
  <% end %>

  <% if @envelopes.empty? %>
    <div class="<%= ui.card %> text-center py-12">
      <p class="<%= ui.label(:secondary) %>">No envelopes yet.</p>
      <% if current_user&.owner? %>
        <%= link_to "Add your first envelope", new_envelope_path, class: "#{ui.button(:primary)} mt-4 inline-block" %>
      <% end %>
    </div>
  <% end %>
</div>

<%# Debt Snowball summary card %>
<% if @snowball_target %>
  <div class="<%= ui.card %> mt-6">
    <div class="<%= ui.card_header %>">
      <h2 class="<%= ui.label %>">Debt Snowball</h2>
      <%= link_to "View all", debts_path, class: ui.link(:subtle) %>
    </div>

    <p class="text-[13px] text-hs-muted mb-1">Current target</p>
    <p class="text-xl font-bold text-hs-navy"><%= @snowball_target.name %></p>
    <p class="<%= ui.stat_value %> mt-1"><%= number_to_currency(@snowball_target.current_balance) %></p>

    <div class="h-2 rounded-full bg-hs-border overflow-hidden mt-3 mb-1">
      <div class="h-full rounded-full bg-hs-primary" style="width: <%= @snowball_target.progress_pct %>%"></div>
    </div>
    <p class="text-[12px] text-hs-muted"><%= @snowball_target.progress_pct %>% paid off</p>

    <p class="<%= ui.label(:secondary) %> mt-3">
      Total non-mortgage debt: <%= number_to_currency(@total_snowball) %>
    </p>
  </div>
<% end %>
