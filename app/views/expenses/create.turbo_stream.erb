<%= render "expenses/dashboard_refresh" %>

<%
  budget = @budget_month.budget_for(@envelope)
  left   = budget - @budget_month.spent_for(@envelope)
  detail = []
  detail << friendly_day(@expense.transacted_on) unless @expense.transacted_on == Date.current
  if budget.positive? && !@expense.prior_month?
    detail << (left.negative? ? "#{number_to_currency(left.abs)} over budget" : "#{number_to_currency(left)} left")
  end
%>
<%= turbo_stream.update "toasts" do %>
  <%= render ToastComponent.new(
        message:   "Saved #{number_to_currency(@expense.amount)} to #{@envelope.name}",
        detail:    detail.join(" · ").presence,
        undo_path: envelope_expense_path(@envelope, @expense)) %>
<% end %>
