<% content_for :title, "#{@envelope.name} · Clempo" %>
<div class="max-w-lg mx-auto">
  <%= render "shared/breadcrumbs", trail: [ [ "Budget", dashboard_path(year: @envelope_month.date.year, month: @envelope_month.date.month) ], [ @envelope.name ] ] %>

  <div class="mb-6 rise">
    <%= render "shared/month_switcher",
          date: @envelope_month.date,
          title: @envelope.name,
          url: ->(d) { envelope_expenses_path(@envelope, year: d.year, month: d.month) } %>
  </div>

  <%= render "expenses/month", envelope_month: @envelope_month %>
</div>
