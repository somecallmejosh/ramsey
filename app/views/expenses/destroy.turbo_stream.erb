<%= turbo_stream.replace "envelope-month", partial: "expenses/month", locals: { envelope_month: @envelope_month } %>
<%= render "expenses/dashboard_refresh" %>

<%= turbo_stream.update "toasts" do %>
  <%= render ToastComponent.new(
        message: "Removed #{number_to_currency(@expense.amount)} from #{@envelope.name}",
        undo_path: restore_envelope_expenses_path(@envelope),
        undo_method: :post,
        undo_params: { token: @expense.restore_token },
        tone: :info) %>
<% end %>
