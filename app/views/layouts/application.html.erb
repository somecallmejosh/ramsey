<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Ramsey" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="application-name" content="Ramsey">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#4865DB">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Reddit+Sans:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-hs-primary focus:text-white focus:rounded">
      Skip to main content
    </a>

    <%= render "layouts/nav" if authenticated? %>

    <%= turbo_frame_tag "flash-messages" %>

    <% if notice.present? %>
      <div class="fixed top-4 right-4 z-50 bg-hs-green/90 text-hs-navy text-sm font-semibold px-4 py-3 rounded-xl shadow-card flex items-center gap-3"
           role="status"
           data-controller="flash"
           data-action="animationend->flash#remove">
        <%= notice %>
        <button type="button"
                class="shrink-0 -mr-1 p-1 rounded-lg hover:bg-hs-navy/10 active:bg-hs-navy/20"
                aria-label="Dismiss"
                data-action="flash#remove">
          <%= icon "close", classes: "w-4 h-4" %>
        </button>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="fixed top-4 right-4 z-50 bg-hs-red-soft/90 text-hs-navy text-sm font-semibold px-4 py-3 rounded-xl shadow-card"
           role="alert">
        <%= alert %>
      </div>
    <% end %>

    <main id="main-content" tabindex="-1" class="max-w-md mx-auto px-4 pb-24 pt-6">
      <%= yield %>
    </main>

    <%= turbo_frame_tag "modal" %>
  </body>
</html>
