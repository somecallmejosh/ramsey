<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Clempo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="application-name" content="Clempo">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#eff0f5"><%# matches --color-bg %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon-96x96.png" type="image/png">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-porcelain focus:rounded-[4px]">
      Skip to main content
    </a>
    <%= render "layouts/nav" if authenticated? %>

    <%# Toasts sit above the bottom nav, in thumb reach and out of the way. %>
    <div id="toasts"
         class="fixed inset-x-0 bottom-[calc(92px+env(safe-area-inset-bottom))] z-[60] px-4 pointer-events-none"
         aria-live="polite"><% if notice.present? %><%= render ToastComponent.new(message: notice) %><% end %></div>

    <main id="main-content" tabindex="-1" class="px-4 pb-32 focus:outline-none">
      <% if authenticated? %>
        <header class="max-w-lg mx-auto flex items-center justify-between gap-3 pt-[max(1rem,env(safe-area-inset-top))] pb-2 mb-4">
          <%= link_to root_path, class: "flex items-center gap-3 min-w-0 rounded-full pr-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent", aria: { label: "Clempo home" } do %>
            <span class="grid place-items-center w-11 h-11 rounded-full bg-lilac text-lilac-ink font-bold text-[17px]" aria-hidden="true">
              <%= current_user.display_name.first %>
            </span>
            <span class="min-w-0 leading-tight">
              <span class="block text-[13px] text-mute"><%= greeting %></span>
              <span class="block text-[17px] font-bold text-ink truncate"><%= current_user.display_name %></span>
            </span>
          <% end %>
          <div class="flex items-center gap-2">
            <% if current_user&.owner? %>
              <%= link_to admin_settings_path, class: ui.icon_button, aria: { label: "Settings" } do %>
                <%= icon "settings", classes: "w-5 h-5" %>
              <% end %>
            <% end %>
            <%= button_to session_path, method: :delete,
                  class: ui.icon_button,
                  aria: { label: "Sign out" },
                  form: { "data-turbo-confirm": "Sign out of Clempo?" } do %>
              <%= icon "logout", classes: "w-5 h-5" %>
            <% end %>
          </div>
        </header>
      <% end %>

      <% if alert.present? %>
        <div class="max-w-lg mx-auto"><%= render FormErrorsComponent.new(messages: alert) %></div>
      <% end %>

      <div class="max-w-7xl mx-auto">
        <%= yield %>
      </div>
    </main>

    <%= turbo_frame_tag "modal" %>
  </body>
</html>
