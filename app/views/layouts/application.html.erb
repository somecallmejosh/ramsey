<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Ramsey" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="application-name" content="Ramsey">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#4865DB">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon-96x96.png" type="image/png">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Reddit+Sans:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-hs-primary focus:text-white focus:rounded">
      Skip to main content
    </a>
    <%= render "layouts/nav" if authenticated? %>

    <%= turbo_frame_tag "flash-messages" %>

    <% if notice.present? %>
      <div class="bg-hs-green/90 text-hs-navy text-sm font-semibold px-4 py-3 rounded-xl shadow-card flex items-center gap-3"
           role="status"
           data-controller="flash"
           data-action="animationend->flash#remove">
        <%= notice %>
        <button type="button"
                class="shrink-0 -mr-1 p-1 rounded-lg hover:bg-hs-navy/10 active:bg-hs-navy/20"
                aria-label="Dismiss"
                data-action="flash#remove">
          <%= icon "close", classes: "w-4 h-4" %>
        </button>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="bg-hs-red-soft/90 text-hs-navy text-sm font-semibold px-4 py-3 rounded-xl shadow-card"
           role="alert">
        <%= alert %>
      </div>
    <% end %>

    <main id="main-content" class="px-4 pb-24">
      <div class="bg-hs-blue-pale/50 sticky top-0 z-50 mb-6 -mx-4 p-4 outline outline-1 outline-hs-primary/[15%] backdrop-blur-xl flex items-center justify-between">
        <%= link_to root_path, class: "flex items-center items-center", aria: { label: "Dashboard" } do %>
          <%= icon "ramsey2", classes: "size-12 translate-y-1" %>
          <span class="text-xl font-semibold text-hs-primary-dark -translate-x-1">ramsey</span>
        <% end %>
        <div class="flex items-center">
          <%= button_to session_path, method: :delete,
            class: ui.nav_item,
            aria: { label: "Sign out" },
            form: { "data-turbo-confirm": "Sign out?" } do %>
            <%= icon "lock", classes: "w-6 h-6" %>
            <span class="sr-only">Sign out</span>
          <% end %>
          <% if current_user&.admin? %>
            <%= link_to admin_settings_path, class: ui.nav_item, aria: { label: "Settings" } do %>
              <%= icon "settings", classes: "w-6 h-6" %>
              <span class="sr-only">Settings</span>
            <% end %>
          <% end %>
        </div>
      </div>
      <div class="max-w-7xl mx-auto">
        <%= yield %>
      </div>
    </main>

    <%= turbo_frame_tag "modal" %>
  </body>
</html>
