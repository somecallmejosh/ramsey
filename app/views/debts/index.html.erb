<% content_for :title, "Debts" %>

<div class="mb-6 flex items-start justify-between gap-4">
  <div>
    <h1 class="<%= ui.page_heading %>">Debts</h1>
    <p class="<%= ui.label(:secondary) %> text-mute mt-1">Pay off the smallest debt first. When it's gone, add its payment to the next one.</p>
  </div>
  <% if current_user.owner? && (@snowball_debts.any? || @mortgage || @paid_off.any?) %>
    <%= link_to "Add debt", new_admin_debt_path, class: ui.button(:primary, extra: "shrink-0 text-sm px-5 py-2") %>
  <% end %>
</div>

<% if @snowball_debts.any? %>
  <h2 class="<%= ui.section_heading %> mb-4">Paying off now</h2>
  <div class="grid grid-cols-1 gap-4 mb-8">
    <% @snowball_debts.each_with_index do |debt, index| %>
      <%= render DebtCardComponent.new(
            debt: debt,
            current_user: current_user,
            snowball_target: index == 0,
            can_move_up: index > 0,
            can_move_down: index < @snowball_debts.size - 1) %>
    <% end %>
  </div>
<% end %>

<% if @mortgage %>
  <h2 class="<%= ui.section_heading %> mb-4">Mortgage</h2>
  <div class="mb-8">
    <%= render DebtCardComponent.new(debt: @mortgage, current_user: current_user) %>
  </div>
<% end %>

<% if @snowball_debts.empty? && @mortgage.nil? && @paid_off.any? %>
  <div class="<%= ui.card %> text-center py-10 mb-8">
    <%= icon "check-circle", classes: "w-10 h-10 text-sage" %>
    <p class="<%= ui.section_heading %> mt-3">You're debt-free!</p>
    <p class="<%= ui.label(:secondary) %> text-mute mt-1">Every debt here is paid off. Nice work.</p>
  </div>
<% end %>

<% if @paid_off.any? %>
  <h2 class="<%= ui.section_heading %> mb-4">Paid off</h2>
  <div class="grid grid-cols-1 gap-4">
    <% @paid_off.each do |debt| %>
      <%= render DebtCardComponent.new(debt: debt, current_user: current_user) %>
    <% end %>
  </div>
<% end %>

<% if @snowball_debts.empty? && @mortgage.nil? && @paid_off.empty? %>
  <div class="<%= ui.card %> text-center py-12">
    <p class="<%= ui.label(:secondary) %>">No debts added yet.</p>
    <% if current_user.owner? %>
      <%= link_to "Add debt", new_admin_debt_path, class: ui.button(:primary, extra: "mt-4 inline-block") %>
    <% else %>
      <p class="<%= ui.label(:secondary) %> text-mute mt-1">Ask the household owner to add your debts.</p>
    <% end %>
  </div>
<% end %>
