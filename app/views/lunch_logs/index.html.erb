<%# Back link + heading %>
<div class="flex items-center gap-3 mb-6">
  <%= link_to root_path, class: "text-mute hover:text-ink transition-colors", aria: { label: "Back to dashboard" } do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
  <% end %>
  <h1 class="<%= ui.page_heading %>">Lunch Tracker</h1>
</div>

<%# Month selector %>
<div class="flex gap-2 overflow-x-auto pb-2 mb-6 -mx-4 px-4 scrollbar-hide" role="navigation" aria-label="Month navigation">
  <% 0.upto(6) do |n| %>
    <% d = Date.current.beginning_of_month - n.months %>
    <% is_current = d.month == @month && d.year == @year %>
    <%= link_to "#{d.strftime("%b")} #{d.year != Date.current.year ? d.year : ""}".strip,
          lunch_logs_path(year: d.year, month: d.month),
          class: "flex-none px-4 py-2 rounded-full font-sans font-medium text-[13px] whitespace-nowrap transition-colors #{is_current ? "bg-accent text-porcelain" : "bg-porcelain text-graphite border border-border hover:border-accent"}" %>
  <% end %>
</div>

<%# Weekly Mon–Fri grid %>
<div class="<%= ui.card %> mb-6">
  <h2 class="<%= ui.section_heading %> mb-4"><%= @selected_date.strftime("%B %Y") %></h2>
  <p class="md:hidden">Scroll horizontally to view all days.</p>
  <div class="overflow-x-scroll border border-border rounded-lg">
    <div class="divide-y divide-border">
      <% weeks_for_month(@year, @month).each do |week| %>
        <div class="grid grid-cols-5  divide-x divide-border">
          <% week.each do |date| %>
            <%= render "day_cell", date: date, log: @logs.find { |l| l.logged_on == date } %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# Stats %>
<%= render "stats" %>
