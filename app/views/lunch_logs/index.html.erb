<div class="max-w-lg mx-auto">
  <div class="mb-5 rise">
    <%= render "shared/month_switcher",
          date:  @selected_date,
          url:   ->(d) { lunch_logs_path(year: d.year, month: d.month) },
          title: "Lunch" %>
    <p class="<%= ui.label(:secondary) %> mt-3 px-1">Tap each workday you brought lunch from home.</p>
  </div>

  <div class="mb-7 rise" style="--i: 1"><%= render "stats" %></div>

  <%# Mon–Fri calendar — fits a 390px screen without scrolling sideways %>
  <section class="mb-6 rise" style="--i: 2" aria-labelledby="lunch-month-heading">
    <h2 id="lunch-month-heading" class="sr-only">Days in <%= @selected_date.strftime("%B %Y") %></h2>

    <% if @days_packed.zero? %>
      <p id="lunch-empty" class="<%= ui.label(:secondary) %> mb-3 px-1">
        <% if @selected_date == Date.current.beginning_of_month %>
          Nothing logged this month yet. Your first packed lunch will show up here.
        <% else %>
          No packed lunches were logged in <%= @selected_date.strftime("%B") %>.
        <% end %>
      </p>
    <% end %>

    <div class="panel p-3">
      <div class="grid grid-cols-5 gap-2 mb-2" aria-hidden="true">
        <% %w[Mon Tue Wed Thu Fri].each do |d| %>
          <span class="text-center text-[12px] font-semibold text-mute"><%= d %></span>
        <% end %>
      </div>
      <div class="space-y-2">
        <% weeks_for_month(@year, @month).each do |week| %>
          <div class="grid grid-cols-5 gap-2">
            <% week.each do |date| %>
              <%= render "day_cell", date: date, log: @logs.find { |l| l.logged_on == date }, month: @month %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>
</div>
