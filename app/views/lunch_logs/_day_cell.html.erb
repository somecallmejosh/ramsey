<%# One weekday in the lunch calendar. The whole tile is the button.
    Only past days of the shown month can be logged. %>
<%# locals: (date:, log:, month:) %>
<% today    = date == Date.current %>
<% in_month = date.month == month %>
<% loggable = in_month && date <= Date.current %>
<% tile     = "press w-full h-[68px] rounded-[18px] flex flex-col items-center justify-center gap-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2" %>
<div id="day_<%= date.to_s %>" class="min-w-0" <%= "aria-current=date" if today %>>
  <% if !loggable %>
    <div class="h-[68px] rounded-[18px] flex flex-col items-center justify-center <%= in_month ? "text-mute" : "text-silver" %>">
      <span class="text-[15px] font-semibold tabular-nums"><%= date.day %></span>
    </div>
  <% elsif log %>
    <%= button_to lunch_log_path(log), method: :delete,
          class: "#{tile} bg-ink text-surface shadow-[0_8px_18px_-8px_oklch(0.2_0.02_265/0.6)]",
          aria: { label: "Packed lunch on #{date.strftime("%b %-d")}. Tap to undo." } do %>
      <span class="text-[15px] font-bold tabular-nums"><%= date.day %></span>
      <span class="inline-flex items-center gap-0.5 text-[11px] font-semibold text-sage-bright"><%= icon "check", classes: "w-3 h-3" %>Packed</span>
    <% end %>
  <% else %>
    <%= button_to lunch_logs_path(logged_on: date.to_s), method: :post,
          class: "#{tile} bg-porcelain-2 text-ink hover:bg-porcelain-3 #{"ring-2 ring-accent" if today}",
          aria: { label: "Log packed lunch for #{date.strftime("%b %-d")}" } do %>
      <span class="text-[15px] font-bold tabular-nums <%= "text-accent" if today %>"><%= date.day %></span>
      <span class="text-[11px] font-semibold <%= today ? "text-accent" : "text-mute" %>"><%= today ? "Today" : "Log" %></span>
    <% end %>
  <% end %>
</div>
