<% content_for :title, "Invitations" %>
<% valid_for = pluralize(Invitation::VALID_FOR.in_days.to_i, "day") %>
<div class="max-w-lg mx-auto">

  <%= render "shared/breadcrumbs", trail: [ [ "Settings", admin_settings_path ], [ "Invite someone" ] ] %>

  <div class="mb-6">
    <h1 class="<%= ui.page_heading %>">Invite someone</h1>
    <p class="<%= ui.label(:secondary) %> mt-1">
      Create a link and send it to the person you want to add to <%= current_account.name %> — by text, email, or however you like. Links work for <%= valid_for %>.
    </p>
  </div>

  <div class="<%= ui.card %> mb-8">
    <%= form_with url: invitations_path do |f| %>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
        <div class="flex-1">
          <label for="email" class="<%= ui.label %> block mb-1">Their email (optional)</label>
          <%= f.email_field :email,
                id: "email",
                placeholder: "partner@example.com",
                aria: { describedby: "email_hint" },
                class: ui.input %>
          <p id="email_hint" class="<%= ui.type(:small, extra: "mt-1") %>">Just a note so you know who each link is for. We don't send an email — you share the link yourself.</p>
        </div>
        <%= f.submit "Create invite link",
              class: "#{ui.button(:primary)} w-full sm:w-auto sm:mt-[22px] whitespace-nowrap",
              data: { turbo_submits_with: "Creating…" } %>
      </div>
    <% end %>
  </div>

  <h2 class="<%= ui.section_heading %> mb-4">Pending invites</h2>

  <% if @invitations.any? %>
    <ul class="space-y-3">
      <% @invitations.each do |invitation| %>
        <% name = invitation.email.presence || "Invite created #{invitation.created_at.strftime("%b %-d")}" %>
        <li class="<%= ui.card %>">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="<%= ui.type(:body_strong, extra: "truncate") %>"><%= name %></p>
              <p class="<%= ui.type(:small) %>">Works for <%= distance_of_time_in_words_to_now(invitation.expires_at) %> more</p>
            </div>
            <%= button_to "Revoke", invitation_path(invitation),
                  method: :delete,
                  class: ui.button(:secondary, extra: "shrink-0 text-[13px] px-4 py-2 min-h-[44px]"),
                  form: { data: { turbo_confirm: "Revoke the invite for #{name}? The link will stop working." } } %>
          </div>

          <div class="mt-3 flex gap-2" data-controller="clipboard">
            <label for="invite_link_<%= invitation.id %>" class="sr-only">Invite link for <%= name %></label>
            <input type="text"
                   id="invite_link_<%= invitation.id %>"
                   value="<%= accept_invitation_url(token: invitation.token) %>"
                   readonly
                   class="<%= ui.input %> min-w-0 flex-1 truncate text-graphite"
                   data-clipboard-target="source"
                   data-action="focus->clipboard#select">
            <button type="button"
                    class="<%= ui.button(:secondary, extra: "shrink-0 whitespace-nowrap") %>"
                    data-clipboard-target="button"
                    data-action="clipboard#copy">Copy link</button>
            <span class="sr-only" role="status" data-clipboard-target="status"></span>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="<%= ui.card %> text-center">
      <p class="<%= ui.type(:body_strong) %>">No pending invites</p>
      <p class="<%= ui.type(:small, extra: "mt-1") %>">Links you create show up here until they're used or expire.</p>
    </div>
  <% end %>
</div>
