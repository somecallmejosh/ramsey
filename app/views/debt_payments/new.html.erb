<%= turbo_frame_tag "modal" do %>
  <%= render ModalComponent.new(title: "Log payment", id: "payment-modal", open: true) do |m| %>
    <% m.with_body do %>
      <p class="<%= ui.label(:secondary) %> -mt-4 mb-6"><%= @debt.name %></p>

      <%= form_with model: [@debt, @debt_payment], class: "space-y-5" do |f| %>
        <%= render FormErrorsComponent.new(record: @debt_payment) %>
        <% error_for = ->(attr) { @debt_payment.errors.full_messages_for(attr).first } %>

        <div>
          <%= f.label :amount, "Amount paid", class: ui.label %>
          <%= f.number_field :amount, step: "0.01", min: "0.01", inputmode: "decimal",
                class: "#{ui.input(error_for.(:amount) ? :error : :default)} mt-1",
                placeholder: "0.00", required: true,
                aria: { invalid: error_for.(:amount).present?,
                        describedby: [ ("debt_payment_amount_error" if error_for.(:amount)),
                                       "debt_payment_amount_hint" ].compact.join(" ") } %>
          <% if error_for.(:amount) %>
            <p id="debt_payment_amount_error" class="<%= ui.field_error %>"><%= error_for.(:amount) %></p>
          <% end %>
          <p id="debt_payment_amount_hint" class="<%= ui.type(:small, extra: "text-mute mt-1") %>">Comes off your <%= number_to_currency(@debt.current_balance) %> balance.</p>
        </div>

        <%# Most payments just come off the balance. The statement balance is only
            for when interest or fees make it differ, so it stays tucked away. %>
        <details class="group" <%= "open" if @debt_payment.balance_after.present? || error_for.(:balance_after) %>>
          <summary class="<%= ui.link(:subtle) %> cursor-pointer list-none inline-flex items-center gap-1 min-h-[44px] [&::-webkit-details-marker]:hidden">
            My statement shows a different balance
            <span aria-hidden="true" class="transition-transform group-open:rotate-90">›</span>
          </summary>
          <div class="mt-2">
            <%= f.label :balance_after, "Balance after this payment", class: ui.label %>
            <%= f.number_field :balance_after, step: "0.01", min: "0", inputmode: "decimal",
                  class: "#{ui.input(error_for.(:balance_after) ? :error : :default)} mt-1",
                  placeholder: "0.00",
                  aria: { invalid: error_for.(:balance_after).present?,
                          describedby: [ ("debt_payment_balance_after_error" if error_for.(:balance_after)),
                                         "debt_payment_balance_after_hint" ].compact.join(" ") } %>
            <% if error_for.(:balance_after) %>
              <p id="debt_payment_balance_after_error" class="<%= ui.field_error %>"><%= error_for.(:balance_after) %></p>
            <% end %>
            <p id="debt_payment_balance_after_hint" class="<%= ui.type(:small, extra: "text-mute mt-1") %>">Use this when interest or fees mean the balance isn't simply <%= number_to_currency(@debt.current_balance) %> minus the payment.</p>
          </div>
        </details>

        <div>
          <%= f.label :paid_on, "Date", class: ui.label %>
          <%= f.date_field :paid_on, max: Date.current,
                class: "#{ui.input(error_for.(:paid_on) ? :error : :default)} mt-1",
                required: true,
                aria: { invalid: error_for.(:paid_on).present?,
                        describedby: ("debt_payment_paid_on_error" if error_for.(:paid_on)) } %>
          <% if error_for.(:paid_on) %>
            <p id="debt_payment_paid_on_error" class="<%= ui.field_error %>"><%= error_for.(:paid_on) %></p>
          <% end %>
        </div>

        <div>
          <%= f.label :note, "Note (optional)", class: ui.label %>
          <%= f.text_field :note, class: "#{ui.input} mt-1", placeholder: "Extra principal, etc." %>
        </div>

        <%= f.submit "Log payment", class: "#{ui.button(:primary)} w-full mt-2",
              data: { turbo_submits_with: "Saving…" } %>
      <% end %>

      <div class="mt-4">
        <%= link_to "Cancel", debt_path(@debt), class: ui.link(:subtle), data: { turbo_frame: "modal" } %>
      </div>
    <% end %>
  <% end %>
<% end %>
