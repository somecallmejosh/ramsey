<div id="shopping-list">
  <% items     = meal_plan.shopping_items.order(:store, :name).to_a %>
  <% total     = items.sum { |i| i.estimated_cost || 0 } %>
  <% remaining = current_groceries_remaining %>

  <% if items.any? %>
    <% if total > remaining %>
      <div class="<%= ui.warning_banner %> mb-4">
        Estimated cart (<%= number_to_currency(total) %>) is more than what's left for groceries (<%= number_to_currency(remaining) %>).
      </div>
    <% end %>

    <div class="<%= ui.card %> mb-4">
      <% items.group_by(&:store).each do |store, store_items| %>
        <h3 class="<%= ui.label %> pt-2 pb-1 border-b border-line mb-1 text-graphite uppercase tracking-wide"><%= store %></h3>
        <% store_items.each do |item| %>
          <%= render "shopping_items/shopping_item", shopping_item: item %>
        <% end %>
      <% end %>
    </div>

    <div class="<%= ui.stat_card %> mb-4">
      <p class="<%= ui.label %> mb-1">Estimated total</p>
      <p class="<%= ui.stat_value %>"><%= number_to_currency(total) %></p>
      <p class="<%= ui.label(:secondary) %>">
        <%= number_to_currency(remaining) %> left for groceries this month
      </p>
    </div>
  <% else %>
    <div class="<%= ui.card %> mb-4 text-center py-8">
      <p class="text-ink font-medium">Your shopping list is empty.</p>
      <p class="<%= ui.label(:secondary) %> mt-1">Add anything you need to buy below.</p>
    </div>
  <% end %>

  <%= render "shopping_items/form", shopping_item: ShoppingItem.new(store: "Aldi"), meal_plan: meal_plan %>
</div>
