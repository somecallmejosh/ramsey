<%= turbo_stream.replace "shopping_item_#{@shopping_item.id}" do %>
  <div id="shopping_item_<%= @shopping_item.id %>">
    <div class="flex items-center gap-3 py-3 border-b border-border last:border-0">
      <%= form_with model: @shopping_item, url: shopping_item_path(@shopping_item), method: :patch do |f| %>
        <%= f.check_box :checked,
              id: "item_#{@shopping_item.id}",
              class: "w-5 h-5 rounded border-border text-accent focus:ring-accent shrink-0",
              onchange: "this.form.requestSubmit()",
              checked: @shopping_item.checked %>
      <% end %>
      <label for="item_<%= @shopping_item.id %>"
             class="flex-1 text-lg <%= @shopping_item.checked? ? "line-through text-mute" : "text-ink" %>">
        <%= @shopping_item.name %>
        <% if @shopping_item.quantity.present? %>
          <span class="<%= ui.label(:secondary) %> ml-1"><%= @shopping_item.quantity %></span>
        <% end %>
      </label>
      <% if @shopping_item.estimated_cost&.positive? %>
        <span class="<%= ui.label(:secondary) %> shrink-0"><%= number_to_currency(@shopping_item.estimated_cost) %></span>
      <% end %>
      <% unless @shopping_item.checked? %>
        <%= button_to shopping_item_path(@shopping_item), method: :delete,
              class: "shrink-0 text-mute hover:text-claret transition-colors ml-1",
              aria: { label: "Remove #{@shopping_item.name}" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true">
            <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
