<% content_for :title, "Add a category · Clempo" %>
<div class="max-w-lg mx-auto">
  <%= render "shared/breadcrumbs", trail: [ [ "Settings", admin_settings_path ], [ "Add a category" ] ] %>
  <h1 class="<%= ui.page_heading %> mb-6">Add a category</h1>

  <% amount_error = @envelope_budget.errors[:amount].first %>
  <div class="<%= ui.card %>">
    <%= form_with model: @envelope, url: envelopes_path, class: "space-y-5" do |f| %>
      <%= render FormErrorsComponent.new(messages: [
            ("Name #{@envelope.errors[:name].first}" if @envelope.errors[:name].any?),
            ("Monthly budget #{amount_error}" if amount_error)
          ]) %>

      <%= render "envelopes/name_field", f: f, envelope: @envelope %>

      <div>
        <label for="envelope_budget_amount" class="<%= ui.label %> block mb-1">
          Budget for <%= Date.current.strftime("%B") %>
        </label>
        <input type="number" id="envelope_budget_amount" name="envelope_budget_amount"
               value="<%= params[:envelope_budget_amount] %>"
               placeholder="0.00" step="0.01" min="0" inputmode="decimal" required
               class="<%= ui.input(amount_error ? :error : :default) %>"
               aria-describedby="envelope_budget_hint<%= " envelope_budget_error" if amount_error %>"
               <%= "aria-invalid=true" if amount_error %>>
        <% if amount_error %>
          <p id="envelope_budget_error" class="<%= ui.field_error %>">Monthly budget <%= amount_error %></p>
        <% end %>
        <p id="envelope_budget_hint" class="text-[13px] text-mute mt-1">Next month starts with the same amount. You can change it any time in Settings.</p>
      </div>

      <div class="flex flex-col-reverse sm:flex-row gap-3 pt-2">
        <%= link_to "Cancel", admin_settings_path, class: ui.button(:secondary, extra: "text-center") %>
        <%= f.submit "Add category", class: ui.button(:primary), data: { turbo_submits_with: "Adding…" } %>
      </div>
    <% end %>
  </div>
</div>
