<% content_for :title, "Edit #{@envelope.name_was} · Clempo" %>
<div class="max-w-lg mx-auto">
  <%= render "shared/breadcrumbs", trail: [ [ "Settings", admin_settings_path ], [ "Edit #{@envelope.name_was}" ] ] %>
  <h1 class="<%= ui.page_heading %> mb-6">Edit <%= @envelope.name_was %></h1>

  <div class="<%= ui.card %>">
    <%= form_with model: @envelope, url: envelope_path(@envelope), method: :patch, class: "space-y-5" do |f| %>
      <%= render FormErrorsComponent.new(record: @envelope) %>

      <%= render "envelopes/name_field", f: f, envelope: @envelope %>

      <div>
        <label class="flex items-start gap-3 cursor-pointer">
          <%= f.check_box :active, id: "envelope_active", class: "mt-1 w-5 h-5 accent-accent" %>
          <span>
            <span class="block text-[15px] font-medium text-ink">Show on Budget</span>
            <span class="block text-[13px] text-mute">Turn off to hide this category. Its past purchases are kept.</span>
          </span>
        </label>
      </div>

      <div class="flex flex-col-reverse sm:flex-row gap-3 pt-2">
        <%= link_to "Cancel", admin_settings_path, class: ui.button(:secondary, extra: "text-center") %>
        <%= f.submit "Save", class: ui.button(:primary), data: { turbo_submits_with: "Saving…" } %>
      </div>
    <% end %>
  </div>
</div>
