<div class="flex items-center justify-center">
  <div class="w-full max-w-sm">

    <div class="mt-8 mb-4">
      <%= image_tag "logos/logo.svg", class: "h-16 w-auto", alt: "Clempo" %>
      <h1 class="<%= ui.section_heading(extra: "mt-4") %>">Forgot your password?</h1>
      <p class="<%= ui.label(:secondary) %> mt-1">Enter the email you sign in with and we'll send you a link to choose a new password.</p>
    </div>

    <div class="<%= ui.card %>">
      <%= form_with url: passwords_path do |f| %>

        <%= render "shared/text_field",
              f: f, type: :email_field, field: :email_address, label: "Email address",
              wrapper_class: "mb-6",
              required: true,
              autofocus: true,
              autocomplete: "username",
              placeholder: "you@example.com",
              value: params[:email_address] %>

        <%= f.submit "Email me a reset link", class: "#{ui.button(:primary)} w-full", data: { turbo_submits_with: "Sending…" } %>

      <% end %>

      <div class="mt-4">
        <%= link_to "Back to sign in", new_session_path, class: ui.link(:subtle) %>
      </div>
    </div>

  </div>
</div>
